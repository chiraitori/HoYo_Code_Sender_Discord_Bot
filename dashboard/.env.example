# Private: used only by the Next.js server, never prefix these with NEXT_PUBLIC_.
MAIN_BOT_API_URL=http://127.0.0.1:3000
AUTH_BOT_SECRET=replace-with-the-same-secret-as-the-bot
DISCORD_CLIENT_SECRET=replace-with-discord-oauth-secret

# Public: these values are visible in the browser.
NEXT_PUBLIC_DISCORD_CLIENT_ID=replace-with-discord-application-id
NEXT_PUBLIC_APP_URL=http://localhost:3001
